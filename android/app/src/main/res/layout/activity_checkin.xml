<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <View
            android:id="@+id/indicator_online"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_status_dot_online" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_house_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Hidden barcode input field -->
    <EditText
        android:id="@+id/edit_barcode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:importantForAutofill="no" />

    <!-- Check type selector -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_check_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_morning"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_type_morning" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_studyhall"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_type_studyhall" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Main result card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <ImageView
                android:id="@+id/icon_status"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_card_scan"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/text_status"
                style="@style/BigStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/icon_status"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/checkin_ready" />

            <TextView
                android:id="@+id/text_student_name"
                style="@style/StudentNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_status"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_student_info"
                style="@style/TemperatureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/text_student_name"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp" />

            <ProgressBar
                android:id="@+id/progress_checkin"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:visibility="gone" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Manual Enter ID button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_manual_input"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/manual_input_full"
        android:textSize="15sp"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1.5dp"
        app:icon="@drawable/ic_keyboard"
        app:iconGravity="textStart"
        app:iconTint="@color/primary"
        app:iconPadding="8dp"
        app:rippleColor="#331565C0" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center"
        android:background="@color/card_background"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:text="DormCheck v0.1.0-beta · Engineered by Zigao Wang" />

</LinearLayout>

    <!-- Temperature Measurement Overlay -->
    <LinearLayout
        android:id="@+id/overlay_temperature"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/card_background"
        android:visibility="gone"
        android:clickable="true"
        android:elevation="8dp">

        <!-- Student info header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/text_temp_student_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_temp_student_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textColor="#B3FFFFFF"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Temperature measurement area -->
        <LinearLayout
            android:id="@+id/layout_temp_reading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/text_temp_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Measuring…"
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_temp_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="180dp"
                    android:textSize="72sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:text="--.-" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°C"
                    android:textSize="28sp"
                    android:textColor="@color/text_secondary"
                    android:layout_gravity="top"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_temp_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point thermometer at forehead"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="16dp" />

        </LinearLayout>

        <!-- Manual numpad (hidden when thermometer is active) -->
        <GridLayout
            android:id="@+id/grid_numpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:columnCount="3"
            android:rowCount="4"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_1"
                style="@style/NumpadButton"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_2"
                style="@style/NumpadButton"
                android:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_3"
                style="@style/NumpadButton"
                android:text="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_4"
                style="@style/NumpadButton"
                android:text="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_5"
                style="@style/NumpadButton"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_6"
                style="@style/NumpadButton"
                android:text="6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_7"
                style="@style/NumpadButton"
                android:text="7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_8"
                style="@style/NumpadButton"
                android:text="8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_9"
                style="@style/NumpadButton"
                android:text="9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_dot"
                style="@style/NumpadButton"
                android:text="." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_0"
                style="@style/NumpadButton"
                android:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_back"
                style="@style/NumpadButton"
                android:text="⌫" />

        </GridLayout>

        <!-- Bottom buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_temp_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_temp_manual"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Manual"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_temp_confirm"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/confirm"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/primary"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
