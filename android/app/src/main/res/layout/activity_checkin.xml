<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Status strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:background="@color/header_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <View
            android:id="@+id/indicator_online"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_status_dot_online" />

        <TextView
            android:id="@+id/text_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Hidden barcode input field -->
    <EditText
        android:id="@+id/edit_barcode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:importantForAutofill="no" />

    <!-- Result area (fills remaining space) -->
    <FrameLayout
        android:id="@+id/area_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/text_student_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="8dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/text_student_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="6dp"
                android:textSize="20sp"
                android:textColor="@color/text_secondary" />

            <ProgressBar
                android:id="@+id/progress_checkin"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

    <!-- Manual ID button -->
    <View
        android:id="@+id/divider_manual"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_manual_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/manual_input_caps"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/btn_bind_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="BIND CARD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/neutral_dark"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/text_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textColor="@color/text_secondary"
        android:text="tally v0.1.0-beta · Engineered by Zigao Wang" />

</LinearLayout>

    <!-- Temperature Measurement Overlay -->
    <LinearLayout
        android:id="@+id/overlay_temperature"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:visibility="gone"
        android:clickable="true">

        <!-- Student info header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/header_bg"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/text_temp_student_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_temp_student_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="#80FFFFFF"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Temperature measurement area -->
        <LinearLayout
            android:id="@+id/layout_temp_reading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_temp_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Measuring…"
                android:textSize="18sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_temp_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="200dp"
                    android:textSize="80sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:text="--.-" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°C"
                    android:textSize="24sp"
                    android:textColor="@color/text_secondary"
                    android:layout_gravity="top"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_temp_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point thermometer at forehead"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Manual numpad -->
        <GridLayout
            android:id="@+id/grid_numpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:columnCount="3"
            android:rowCount="4"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_1"
                style="@style/NumpadButton"
                android:text="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_2"
                style="@style/NumpadButton"
                android:text="2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_3"
                style="@style/NumpadButton"
                android:text="3" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_4"
                style="@style/NumpadButton"
                android:text="4" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_5"
                style="@style/NumpadButton"
                android:text="5" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_6"
                style="@style/NumpadButton"
                android:text="6" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_7"
                style="@style/NumpadButton"
                android:text="7" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_8"
                style="@style/NumpadButton"
                android:text="8" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_9"
                style="@style/NumpadButton"
                android:text="9" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_dot"
                style="@style/NumpadButton"
                android:text="." />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_0"
                style="@style/NumpadButton"
                android:text="0" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_num_back"
                style="@style/NumpadButton"
                android:text="⌫" />

        </GridLayout>

        <!-- Bottom buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_temp_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cancel"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/btn_temp_manual"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="MANUAL"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/btn_temp_confirm"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/confirm"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/accent" />

        </LinearLayout>

    </LinearLayout>

    <!-- Manual ID Entry Overlay -->
    <LinearLayout
        android:id="@+id/overlay_manual_id"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:visibility="gone"
        android:clickable="true">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_bg"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:text="ENTER STUDENT ID" />

        </LinearLayout>

        <!-- ID display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_id_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="200dp"
                android:textSize="56sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:text="—" />

        </LinearLayout>

        <!-- Numpad -->
        <GridLayout
            android:id="@+id/grid_id_numpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:columnCount="3"
            android:rowCount="4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_1"
                style="@style/NumpadButton"
                android:text="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_2"
                style="@style/NumpadButton"
                android:text="2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_3"
                style="@style/NumpadButton"
                android:text="3" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_4"
                style="@style/NumpadButton"
                android:text="4" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_5"
                style="@style/NumpadButton"
                android:text="5" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_6"
                style="@style/NumpadButton"
                android:text="6" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_7"
                style="@style/NumpadButton"
                android:text="7" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_8"
                style="@style/NumpadButton"
                android:text="8" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_9"
                style="@style/NumpadButton"
                android:text="9" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_clear"
                style="@style/NumpadButton"
                android:text="CLR" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_0"
                style="@style/NumpadButton"
                android:text="0" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_id_back"
                style="@style/NumpadButton"
                android:text="⌫" />

        </GridLayout>

        <!-- Bottom buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_id_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cancel"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/btn_id_confirm"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/confirm"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/accent" />

        </LinearLayout>

    </LinearLayout>

    <!-- Tech Hand-in Overlay -->
    <LinearLayout
        android:id="@+id/overlay_tech_handin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:visibility="gone"
        android:clickable="true">

        <!-- Student header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/header_bg"
            android:padding="16dp"
            android:gravity="center">

            <TextView
                android:id="@+id/text_tech_student_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_tech_student_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textColor="#80FFFFFF"
                android:gravity="center"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Device checkboxes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uncheck devices NOT handed in"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="24dp" />

            <CheckBox
                android:id="@+id/cb_tech_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textSize="22sp"
                android:minHeight="56dp"
                android:checked="true" />

            <CheckBox
                android:id="@+id/cb_tech_laptop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laptop"
                android:textSize="22sp"
                android:minHeight="56dp"
                android:checked="true" />

            <CheckBox
                android:id="@+id/cb_tech_ipad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iPad"
                android:textSize="22sp"
                android:minHeight="56dp"
                android:checked="false" />

        </LinearLayout>

        <!-- Bottom buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_tech_cancel"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cancel"
                android:textSize="16sp"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/btn_tech_photo"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="2"
                android:gravity="center"
                android:text="TAKE PHOTO"
                android:textSize="18sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/success" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
